# Copy to .env for local runs. Never commit .env. In hosting, set these in the secret store.

# Gemini guides (server-side only). Leave empty to use curated guides.
GEMINI_API_KEY=
ECOREVIVE_GEMINI_MODEL=gemini-3.5-flash-lite

# Model
ECOREVIVE_MODEL_DIR=models/current
ECOREVIVE_MODEL_STATUS=preview
# For containers that download the model at start (checksum verified):
MODEL_VERSION=
MODEL_BASE_URL=

# Capacity (measure before raising)
ECOREVIVE_INFERENCE_CONCURRENCY=1
ECOREVIVE_INFERENCE_QUEUE_DEPTH=4
ECOREVIVE_INFERENCE_TIMEOUT_S=10
ECOREVIVE_ONNX_THREADS=2

# Only needed when the site and API are on different origins (JSON list).
ECOREVIVE_ALLOWED_ORIGINS=["http://localhost:5173"]
ECOREVIVE_LOG_LEVEL=INFO
